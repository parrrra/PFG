@using GymPlanner.Common.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authState">
            <header class="top-bar navbar navbar-dark bg-dark d-md-none">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center" href="/">
                        <i class="bi bi-heart-pulse fs-4 me-2"></i>
                        GymPlanner
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar"
                        aria-controls="sidebar" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
            </header>

            <div class="offcanvas offcanvas-start bg-dark text-white d-flex flex-column p-0" tabindex="-1" id="sidebar">
                <button type="button" class="btn-close btn-close-white d-md-none" data-bs-dismiss="offcanvas"
                    aria-label="Cerrar"></button>

                <div class="brand d-none d-md-flex align-items-center px-3 py-4">
                    <i class="bi bi-heart-pulse fs-4 me-2"></i>
                    <span class="fs-5 fw-bold">GymPlanner</span>
                </div>

                <nav class="nav flex-column flex-grow-1 p-1 gap-1">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill me-2"></i>
                        Inicio
                    </NavLink>

                    <NavLink class="nav-link" href="calendar">
                        <i class="bi bi-calendar-event me-2"></i>
                        Calendario
                    </NavLink>

                    <NavLink class="nav-link" href="routines">
                        <i class="bi bi-calendar2-week me-2"></i>
                        Rutinas
                    </NavLink>

                    <NavLink class="nav-link" href="trainingtemplates">
                        <i class="bi bi-bar-chart-steps me-2"></i>
                        Plantillas de entrenamientos
                    </NavLink>

                    <NavLink class="nav-link" href="exercise-progress">
                        <i class="bi bi-graph-up-arrow me-2"></i>
                        Seguimiento de Progreso
                    </NavLink>

                    @if (authState.User.IsInRole(Roles.Admin))
                    {
                        <div class="mt-2 mb-1 ps-2 text-uppercase text-muted small" style="font-size: 0.75rem;">Admin</div>
                        <NavLink class="nav-link" href="admin/bodyparts">
                            <i class="bi bi-list-nested me-2"></i>
                            Partes&nbsp;del&nbsp;cuerpo
                        </NavLink>
                        <NavLink class="nav-link" href="admin/exercises">
                            <i class="bi bi-person-arms-up me-2"></i>
                            Ejercicios
                        </NavLink>
                        <NavLink class="nav-link" href="admin/users">
                            <i class="bi bi-people-fill me-2"></i>
                            Usuarios
                        </NavLink>
                    }
                </nav>
                <div class="bottom-panel d-flex align-items-center gap-2 p-3">
                    <NavLink class="me-auto small d-flex align-items-center text-white text-decoration-none"
                        href="profile">
                        <i class="bi bi-person-circle me-1"></i>
                        @authState.User.Identity?.Name
                    </NavLink>
                    <NavLink class="btn btn-light btn-sm d-flex align-items-center" href="logout">
                        <i class="bi bi-box-arrow-left me-1"></i>
                        Salir
                    </NavLink>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>
