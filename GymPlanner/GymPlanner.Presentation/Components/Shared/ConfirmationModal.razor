@inject IJSRuntime JSRuntime

<div class="modal fade" tabindex="-1" role="dialog" id="@ModalId" aria-labelledby="@ModalIdLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@ModalIdLabel">@Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>@Message</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                    @onclick="Cancel">Cancelar</button>
                <button type="button" class="btn @ConfirmButtonClass" @onclick="Confirm">
                    @if (!string.IsNullOrEmpty(ConfirmIcon))
                    {
                        <i class="@ConfirmIcon me-2"></i>
                    }
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ModalId { get; set; } = "confirmationModal";
    private string ModalIdLabel => $"{ModalId}Label";

    [Parameter] public string Title { get; set; } = "Confirmación";
    [Parameter] public string Message { get; set; } = "¿Estás seguro de que quieres continuar?";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-primary";
    [Parameter] public string? ConfirmIcon { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    public async Task ShowAsync()
    {
        await JSRuntime.InvokeVoidAsync("bootstrapInterop.showModal", ModalId);
    }

    public async Task HideAsync()
    {
        await JSRuntime.InvokeVoidAsync("bootstrapInterop.hideModal", ModalId);
    }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync(null);
        await HideAsync();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync(null);
        await HideAsync();
    }
}
