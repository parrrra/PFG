@page "/trainings/edit/{id:guid}"
@attribute [Authorize(Roles = $"{GymPlanner.Common.Constants.Roles.Admin},{GymPlanner.Common.Constants.Roles.User}")]
@rendermode InteractiveServer
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher
@inject NavigationManager Navigation
@using GymPlanner.Presentation.Components.Pages.Trainings;
@inject BreadcrumbService BreadcrumbSvc

@using GymPlanner.Application.Trainings.Commands.UpdateTraining
@using GymPlanner.Application.Trainings.DTOs
@using GymPlanner.Application.Trainings.Queries.GetTraining
@using GymPlanner.Presentation.ViewModels.TrainingViewModels


<div class="page-edit-grid-container">
    <main class="page-content">
        @if (Form is null)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else
        {
            <EditForm Model="Form" OnValidSubmit="SaveTraining" Id="editTrainingForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger ps-5" />
                <div class="card shadow-lg border-0 rounded-4 mb-4">
                    <div class="card-header bg-primary text-white rounded-top-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                @Form.TrainingTemplateName
                                <label class="form-label fw-bold">(@Form.Date.ToShortDateString())</label>
                            </h4>
                            <span>@(Form.IsCompleted ? "Completado" : "No completado") </span>
                        </div>
                    </div>
                </div>
                @foreach (var ex in Form.Exercises.OrderBy(x => x.Order))
                {
                    <div class="card mb-3 border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold text-muted">Ejercicio</label>
                                    <InputText class="form-control" @bind-Value="ex.ExerciseName" disabled />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small fw-semibold text-muted">Series</label>
                                    <InputNumber class="form-control" @bind-Value="ex.Sets" disabled />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small fw-semibold text-muted">Repeticiones</label>
                                    <InputNumber class="form-control" @bind-Value="ex.Repetitions" disabled />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small fw-semibold text-muted">Peso</label>
                                    <InputNumber class="form-control" @bind-Value="ex.StartWeight" disabled />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-muted">Notas</label>
                                    <InputTextArea class="form-control" @bind-Value="ex.Notes" rows="3" />
                                </div>
                            </div>
                            <TrainingExerciseSetsEditor Sets="@ex.TrainingExerciseSets" />
                        </div>
                    </div>
                }
            </EditForm>
        }
    </main>
    <footer class="page-footer">
        @if (Form is not null)
        {
            <div class="d-flex justify-content-end gap-3">
                <button class="btn btn-secondary" type="button" @onclick="@(() => Navigation.NavigateTo("/calendar"))">
                    <i class="bi bi-x-lg me-2"></i> Cancelar
                </button>
                <button class="btn btn-primary" type="submit" form="editTrainingForm">
                    <i class="bi bi-check-lg me-2"></i> Guardar
                </button>
            </div>
        }
    </footer>
</div>

@code {
    [Parameter] public Guid id { get; set; }

    [SupplyParameterFromForm]
    public TrainingViewModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbSvc.SetBreadcrumbs(new List<BreadcrumbItem>
{
new("Inicio", "/"),
new("Entrenamientos", "/calendar"),
new("Editar Entrenamiento", null)
});

        var query = new GetTrainingQuery { Id = id };
        var dto = await QueryDispatcher.Dispatch<GetTrainingQuery, TrainingDto?>(query, CancellationToken.None);
        if (dto == null)
        {
            Navigation.NavigateTo("/calendar");
            return;
        }
        Form = TrainingMappings.ToViewModel(dto);
    }

    private async Task SaveTraining()
    {
        if (Form == null) return;
        var command = new UpdateTrainingCommand
        {
            Id = Form.Id,
            IsCompleted = true,
            Exercises = Form.Exercises.Select(x => new UpdateTrainingExerciseModel
            {
                Id = x.Id,
                Sets = x.Sets,
                Repetitions = x.Repetitions,
                StartWeight = x.StartWeight,
                TargetWeight = x.TargetWeight,
                IsKeyExercise = x.IsKeyExercise,
                Notes = x.Notes,
                Order = x.Order,
                TrainingExerciseSets = x.TrainingExerciseSets.Select(s => new UpdateTrainingExerciseSetModel
                {
                    Id = s.Id,
                    Order = s.Order,
                    Repetitions = s.Repetitions,
                    Weight = s.Weight
                }).ToList()
            }).ToList()
        };
        await CommandDispatcher.Dispatch<UpdateTrainingCommand, bool>(command, CancellationToken.None);
        Navigation.NavigateTo("/calendar");
    }
}
