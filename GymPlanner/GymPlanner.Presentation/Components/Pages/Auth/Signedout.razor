@page "/signedout"

<PageTitle>Sesión cerrada</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg p-4 rounded">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem; margin-bottom: 20px;"></i>
                    <h3 class="card-title mb-3">¡Has cerrado sesión correctamente!</h3>
                    <p class="text-secondary fs-5">
                        Estás siendo redirigido a la página principal...
                    </p>
                    <div class="spinner-border text-primary mt-4" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<meta http-equiv="refresh" content="1;url=/" />
