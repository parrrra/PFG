@page "/admin/exercises"
@attribute [Authorize(Roles = GymPlanner.Common.Constants.Roles.Admin)]
@rendermode InteractiveServer

@inject BreadcrumbService BreadcrumbSvc
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher
@inject NavigationManager Nav

<PageTitle>Gestión de Ejercicios</PageTitle>

<div class="list-grid-container">
    <header class="list-header">
        <div class="list-header-content">
            <InputText class="form-control" placeholder="Buscar por nombre..." @bind-Value="_filter"
                @oninput="OnFilterTextChanged" />
            <div>
                <InputSelect class="form-select" @bind-Value="_selectedBodyPartId" TValue="Guid ?"
                    @bind-Value:after="OnBodyPartChanged">
                    <option value="">-- Todas las partes --</option>
                    @foreach (var part in BodyParts)
                    {
                        <option value="@part.Id">@part.Name</option>
                    }
                </InputSelect>
            </div>
            <button class="btn btn-secondary" @onclick="ClearFilters" type="button" title="Limpiar filtros">
                <i class="bi bi-x-circle"></i>
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="CreateNew">
                <i class="bi bi-plus-circle"></i>
                <span>Nuevo</span>
            </button>
        </div>
    </header>

    <main class="list-content">
        <div class="main-table-container">
            <table class="main-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Parte del cuerpo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="3" class="text-center p-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!ExerciseList.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center p-4">
                                <p class="mb-0">No se encontraron ejercicios.</p>
                                <small>Intenta con otro filtro o crea uno nuevo.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ex in ExerciseList)
                        {
                            <tr style="cursor: pointer;" @onclick="() => Edit(ex.Id)">
                                <td>@ex.Name</td>
                                <td>@BodyParts.FirstOrDefault(b => b.Id == ex.BodyPartId)?.Name</td>
                                <td class="text-end action-buttons" @onclick:stopPropagation="true">
                                    <button class="btn btn-danger btn-sm" @onclick="() => ShowDeleteConfirmation(ex.Id)"
                                        title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>

    <footer class="list-footer">
        <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" PageSize="PageSize" TotalCount="TotalCount"
            OnPageChanged="LoadExercises" OnPageSizeChanged="ChangePageSize"
            PageSizeOptions="new int[] {5, 10, 20, 50, 100}" />
    </footer>
</div>


<ConfirmationModal @ref="_deleteConfirmationModal" Message="¿Estás seguro de que deseas eliminar este ejercicio?"
    ConfirmText="Eliminar" ConfirmButtonClass="btn-danger" ConfirmIcon="bi bi-trash" OnConfirm="DeleteExercise" />

@code {
    private List<ExerciseViewModel> ExerciseList = [];
    private List<BodyPartDto> BodyParts = [];
    private string? _filter;
    private int CurrentPage = 1;
    private int TotalPages;
    private int TotalCount = 0;
    private int PageSize = 10;
    private bool _isLoading = true;
    private Guid _selectedExerciseId;
    private Guid? _selectedBodyPartId;
    private readonly Debouncer _debouncer = new();
    private ConfirmationModal _deleteConfirmationModal = new();

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbSvc.SetBreadcrumbs(new()
{
new("Inicio", "/"),
new("Ejercicios", "/admin/exercises")
});
        await LoadBodyParts();
        await LoadExercises(1);
    }

    private async Task LoadBodyParts()
    {
        var query = new GetBodyPartsQuery { PageNumber = 1, PageSize = 1000 };
        var result = await QueryDispatcher.Dispatch<GetBodyPartsQuery, PaginatedResult<BodyPartDto>>(query,
        CancellationToken.None);
        BodyParts = result.Items;
    }

    private async Task OnFilterTextChanged(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString();
        CurrentPage = 1;
        await _debouncer.DebounceAsync(async () =>
        {
            await LoadExercises(CurrentPage);
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task OnBodyPartChanged()
    {
        CurrentPage = 1;
        await LoadExercises(CurrentPage);
    }


    private async Task ChangePageSize(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        await LoadExercises(CurrentPage);
    }

    private async Task LoadExercises(int page)
    {
        _isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            CurrentPage = page;
            var query = new GetExercisesQuery
            {
                PageNumber = CurrentPage,
                PageSize = PageSize,
                Filter = _filter,
                BodyPartId = _selectedBodyPartId
            };
            var result = await QueryDispatcher.Dispatch<GetExercisesQuery, PaginatedResult<ExerciseDto>>(query,
            CancellationToken.None);
            ExerciseList = result.Items.Select(ExerciseMappings.ToViewModel).ToList();
            TotalCount = result.TotalCount;
            TotalPages = (int)Math.Ceiling((double)result.TotalCount / PageSize);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Edit(Guid id) => Nav.NavigateTo($"/admin/exercises/edit/{id}");
    private void CreateNew() => Nav.NavigateTo("/admin/exercises/add");

    private async Task ShowDeleteConfirmation(Guid id)
    {
        _selectedExerciseId = id;
        await _deleteConfirmationModal.ShowAsync();
    }

    private async Task DeleteExercise()
    {
        var command = new DeleteExerciseCommand { Id = _selectedExerciseId };
        await CommandDispatcher.Dispatch<DeleteExerciseCommand, bool>(command, CancellationToken.None);
        if (ExerciseList.Count == 1 && CurrentPage > 1) CurrentPage--;
        await LoadExercises(CurrentPage);
    }


    private async Task ClearFilters()
    {
        _filter = null;
        _selectedBodyPartId = null;
        CurrentPage = 1;
        await LoadExercises(CurrentPage);
        await InvokeAsync(StateHasChanged);
    }
}
