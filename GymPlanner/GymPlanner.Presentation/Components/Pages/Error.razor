@page "/Error"
@using System.Diagnostics

<PageTitle>¡Ups! Error inesperado</PageTitle>

<div class="container mt-5 text-center">
    <h1 class="display-4 text-danger">¡Ups! Algo salió mal.</h1>
    <p class="lead">Parece que esta página ha tenido un mal día...</p>

    <img src="https://http.cat/500" alt="Error gracioso" class="img-fluid rounded shadow mt-4 mb-4"
        style="max-width: 400px;" />

    <p>No te preocupes, nuestros desarrolladores ya están acariciando al gato para arreglarlo 🐾.</p>

    @if (ShowRequestId)
    {
        <div class="alert alert-secondary mt-4" role="alert">
            <strong>ID de seguimiento:</strong> <code>@RequestId</code><br />
            Por favor, proporciona este código si contactas con soporte.
        </div>
    }

    <a class="btn btn-primary mt-4" href="/">Volver al inicio</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
