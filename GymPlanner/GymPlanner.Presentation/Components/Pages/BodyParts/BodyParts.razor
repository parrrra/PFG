@page "/admin/bodyparts"
@attribute [Authorize(Roles = GymPlanner.Common.Constants.Roles.Admin)]
@rendermode InteractiveServer

@inject BreadcrumbService BreadcrumbSvc
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher
@inject NavigationManager Nav

<PageTitle>Gestión de Partes del Cuerpo</PageTitle>

<div class="list-grid-container">
    <header class="list-header">
        <div class="list-header-content">
            <InputText class="form-control" placeholder="Buscar por nombre..." @bind-Value="_filter"
                @oninput="OnFilterChanged" />
            <button class="btn btn-secondary" @onclick="ClearFilters" type="button" title="Limpiar filtros">
                <i class="bi bi-x-circle"></i>
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="CreateNew">
                <i class="bi bi-plus-circle"></i>
                <span>Nueva</span>
            </button>
        </div>
    </header>

    <main class="list-content">
        <div class="main-table-container">
            <table class="main-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="2" class="text-center p-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!Parts.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center p-4">
                                <p class="mb-0">No se encontraron partes del cuerpo.</p>
                                <small>Intenta con otro filtro o crea una nueva.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var part in Parts)
                        {
                            <tr style="cursor: pointer;" @onclick="() => Edit(part.Id)">
                                <td>@part.Name</td>
                                <td class="text-end action-buttons" @onclick:stopPropagation="true">
                                    <button class="btn btn-danger btn-sm" @onclick="() => ShowDeleteConfirmation(part.Id)"
                                        title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>


    <footer class="list-footer">
        <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" PageSize="PageSize" TotalCount="TotalCount"
            OnPageChanged="LoadParts" OnPageSizeChanged="ChangePageSize"
            PageSizeOptions="new int[] {5, 10, 20, 50, 100}" />
    </footer>
</div>

<ConfirmationModal @ref="_deleteConfirmationModal" Message="¿Estás seguro de que deseas eliminar esta parte del cuerpo?"
    ConfirmText="Eliminar" ConfirmButtonClass="btn-danger" ConfirmIcon="bi bi-trash" OnConfirm="DeletePart" />

@code {
    private List<BodyPartDto> Parts = [];
    private string? _filter;
    private int CurrentPage = 1;
    private int TotalPages;
    private int TotalCount = 0;
    private int PageSize = 10;
    private bool _isLoading = true;
    private Guid _selectedPartId;

    private readonly Debouncer _debouncer = new();
    private ConfirmationModal _deleteConfirmationModal = new();

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbSvc.SetBreadcrumbs(new()
{
new("Inicio", "/"),
new("Partes del Cuerpo", "/admin/bodyparts")
});
        await LoadParts(1);
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString();
        await _debouncer.DebounceAsync(async () =>
        {
            CurrentPage = 1;
            await LoadParts(CurrentPage);
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ChangePageSize(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        await LoadParts(CurrentPage);
    }

    private async Task LoadParts(int page)
    {
        _isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            CurrentPage = page;
            var query = new GetBodyPartsQuery { PageNumber = CurrentPage, PageSize = PageSize, Filter = _filter };
            var result = await QueryDispatcher.Dispatch<GetBodyPartsQuery, PaginatedResult<BodyPartDto>>(query,
            CancellationToken.None);
            Parts = result.Items;
            TotalCount = result.TotalCount;
            TotalPages = (int)Math.Ceiling((double)result.TotalCount / PageSize);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Edit(Guid id) => Nav.NavigateTo($"/admin/bodyparts/edit/{id}");
    private void CreateNew() => Nav.NavigateTo("/admin/bodyparts/add");

    private async Task ShowDeleteConfirmation(Guid id)
    {
        _selectedPartId = id;
        await _deleteConfirmationModal.ShowAsync();
    }

    private async Task DeletePart()
    {
        var command = new DeleteBodyPartCommand { Id = _selectedPartId };
        await CommandDispatcher.Dispatch<DeleteBodyPartCommand, bool>(command, CancellationToken.None);
        if (Parts.Count == 1 && CurrentPage > 1) CurrentPage--;
        await LoadParts(CurrentPage);
    }

    private async Task ClearFilters()
    {
        _filter = null;
        CurrentPage = 1;
        await LoadParts(CurrentPage);
    }
}
